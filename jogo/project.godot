config_version=5

[application]

config/name="HOLLER"
config/description="Terror e sobrevivencia em primeira pessoa nos montes Apalaches."
config/version="0.1.0"
run/main_scene="res://cenas/principal.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
boot_splash/bg_color=Color(0, 0, 0, 1)
boot_splash/show_image=false
config/icon="res://tex/icone.png"

[autoload]

Teste="*res://scripts/teste.gd"
Jogo="*res://scripts/jogo.gd"
Som="*res://scripts/som.gd"

[debug]

gdscript/warnings/enable=false

[display]

window/size/viewport_width=1920
window/size/viewport_height=1080
window/size/mode=3
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[importer_defaults]

texture={
"compress/mode": 2,
"compress/high_quality": false,
"compress/normal_map": 0,
"mipmaps/generate": true,
"process/fix_alpha_border": true
}

[physics]

3d/physics_engine="Jolt Physics"
common/physics_ticks_per_second=60

[rendering]

renderer/rendering_method="forward_plus"
rendering_device/driver.windows="vulkan"
textures/default_filters/anisotropic_filtering_level=3
lights_and_shadows/directional_shadow/size=4096
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=2
environment/volumetric_fog/volume_size=96
environment/volumetric_fog/volume_depth=96
environment/ssao/quality=1
mesh_lod/lod_change/threshold_pixels=2.0
environment/defaults/default_clear_color=Color(0, 0, 0, 1)
